---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Lincei",
  description = "Lincei is an agentic clinical research environment for verifiable, reviewable studies.",
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/hero-screenshot.webp" />
    <link rel="preload" as="image" href="/hero-screenshot.webp" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/lincei-icon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body>
    <div class="page">
      <nav class="nav" aria-label="Primary">
        <div class="nav-inner">
          <a href="/" class="nav-brand" aria-label="Lincei home">
            <span>Lincei</span>
          </a>
          <div class="nav-right">
            <a
              class="nav-gh"
              href="https://github.com/hannesill/m4"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 007.86 10.93c.58.1.79-.25.79-.56v-2c-3.2.69-3.88-1.37-3.88-1.37-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.68 1.25 3.33.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.27-5.24-5.67 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.15 1.18a10.96 10.96 0 015.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.57.23 2.73.11 3.02.74.8 1.18 1.83 1.18 3.08 0 4.41-2.7 5.38-5.27 5.66.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.56A11.5 11.5 0 0023.5 12C23.5 5.65 18.35.5 12 .5z"/>
              </svg>
              <span>M4</span>
            </a>
            <a class="btn btn-primary" href="mailto:hannes@lincei.ai">Early access</a>
          </div>
        </div>
      </nav>

      <main class="main">
        <slot />
      </main>

      <footer class="footer">
        <div class="footer-inner">
          <div class="footer-brand">
            <span>&copy; {new Date().getFullYear()} Lincei Labs</span>
          </div>
          <div class="footer-links">
            <a href="https://github.com/hannesill/m4" target="_blank" rel="noopener noreferrer">M4</a>
            <a href="https://github.com/hannesill/vitrine" target="_blank" rel="noopener noreferrer">Vitrine</a>
            <a href="mailto:hannes@lincei.ai">Contact</a>
          </div>
        </div>
      </footer>
    </div>

    <script>
      const nav = document.querySelector(".nav");
      const onScroll = () => {
        if (!nav) return;
        nav.classList.toggle("is-scrolled", window.scrollY > 12);
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #ffffff;
    --bg-soft: #f7f7f4;
    --bg-tint: #f1f5ef;
    --fg: oklch(0.205 0 0);
    --fg-muted: oklch(0.47 0 0);
    --fg-dim: oklch(0.61 0 0);
    --border: color-mix(in srgb, oklch(0.54 0 0) 21%, transparent);
    --border-strong: color-mix(in srgb, oklch(0.39 0 0) 28%, transparent);
    --accent: #6d2332;
    --accent-strong: #43121d;
    --sage: #5f7663;
    --gold: #a27538;
    --info: #316d8a;
    --font-sans: "DM Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    --font-serif: "Source Serif 4", "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
    --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, monospace;
    --radius: 6px;
    --shadow-card: 0 1px 0 rgba(255, 255, 255, 0.72) inset, 0 18px 42px -34px rgba(17, 24, 39, 0.32);
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    background: var(--bg);
    scroll-behavior: smooth;
  }

  body {
    min-width: 320px;
    min-height: 100vh;
    overflow-x: hidden;
    background:
      linear-gradient(rgba(17, 24, 39, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(17, 24, 39, 0.045) 1px, transparent 1px),
      radial-gradient(circle at 14% 12%, rgba(95, 118, 99, 0.13), transparent 30%),
      radial-gradient(circle at 88% 7%, rgba(109, 35, 50, 0.12), transparent 28%),
      linear-gradient(180deg, #ffffff 0%, #f8f8f5 56%, #ffffff 100%);
    background-size: 74px 74px, 74px 74px, auto, auto, auto;
    color: var(--fg);
    font-family: var(--font-sans);
    font-feature-settings: "ss01", "ss02";
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body::after {
    content: "";
    position: fixed;
    inset: 0;
    z-index: 100;
    pointer-events: none;
    opacity: 0.045;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 96 96' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='1.8' numOctaves='5' stitchTiles='stitch'/%3E%3CfeColorMatrix type='saturate' values='0'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 96px 96px;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
  }

  img,
  svg {
    display: block;
    max-width: 100%;
  }

  :focus-visible {
    outline: 2px solid color-mix(in srgb, var(--accent) 70%, transparent);
    outline-offset: 3px;
  }

  ::selection {
    background: var(--accent);
    color: #fff;
  }

  .page {
    min-height: 100vh;
  }

  .main {
    position: relative;
    z-index: 1;
  }

  .container {
    width: 100%;
    max-width: 1220px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    padding: 16px 0 8px;
    transition: background 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .nav.is-scrolled {
    background: rgba(255, 255, 255, 0.82);
    border-bottom: 1px solid rgba(17, 24, 39, 0.08);
    box-shadow: 0 14px 32px -30px rgba(17, 24, 39, 0.42);
    backdrop-filter: blur(18px);
  }

  .nav-inner {
    width: min(100% - 40px, 1220px);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .nav-brand,
  .footer-brand {
    display: inline-flex;
    align-items: center;
    font-family: Baskerville, Palatino, Georgia, "Times New Roman", serif;
    font-size: 24px;
    font-weight: 500;
    letter-spacing: 0;
  }

  .nav-brand {
    transition: opacity 0.18s ease;
  }

  .nav-brand:hover {
    opacity: 0.72;
  }

  .nav-right {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .nav-gh {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.55);
    padding: 10px 14px;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    box-shadow: var(--shadow-card);
    transition: border-color 0.18s ease, color 0.18s ease, background 0.18s ease;
  }

  .nav-gh:hover {
    border-color: var(--border-strong);
    background: #fff;
    color: var(--fg);
  }

  .btn {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: var(--radius);
    border: 1px solid transparent;
    padding: 10px 16px;
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
    transition: transform 0.18s ease, background 0.18s ease, border-color 0.18s ease, color 0.18s ease;
  }

  .btn:hover {
    transform: translateY(-1px);
  }

  .btn:active {
    transform: translateY(0);
  }

  .btn-primary {
    background: var(--fg);
    color: #fff;
    box-shadow: 0 14px 24px -20px rgba(17, 24, 39, 0.45);
  }

  .btn-primary:hover {
    background: #111111;
  }

  .btn-ghost {
    border-color: var(--border);
    background: rgba(255, 255, 255, 0.68);
    color: var(--fg);
    box-shadow: var(--shadow-card);
  }

  .btn-ghost:hover {
    border-color: var(--border-strong);
    background: #fff;
  }

  .eyebrow {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .display {
    font-size: clamp(4rem, 8vw, 7.8rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 0.94;
    text-wrap: balance;
  }

  .section-head {
    display: grid;
    max-width: 720px;
    gap: 16px;
  }

  .section-head h2 {
    font-family: var(--font-serif);
    font-size: clamp(2.35rem, 5vw, 5rem);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 0.95;
    text-wrap: balance;
  }

  .section-head p {
    color: var(--fg-muted);
    font-size: clamp(1.05rem, 1.4vw, 1.22rem);
    line-height: 1.65;
  }

  .footer {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.7);
  }

  .footer-inner {
    width: min(100% - 40px, 1220px);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 24px 0;
    color: var(--fg-muted);
    font-size: 14px;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    font-weight: 600;
  }

  .footer-links a:hover {
    color: var(--fg);
  }

  @media (max-width: 760px) {
    .container {
      padding: 0 20px;
    }

    .nav-inner {
      width: min(100% - 28px, 1220px);
    }

    .nav-gh {
      display: none;
    }

    .display {
      font-size: clamp(3.25rem, 17vw, 5.5rem);
    }

    .footer-inner {
      width: min(100% - 32px, 1220px);
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
