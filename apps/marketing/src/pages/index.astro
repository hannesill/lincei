---
import Layout from "../layouts/Layout.astro";

const checkpoints = [
  {
    title: "Cohort definition",
    meta: "2,841 eligible records",
    state: "Reviewing",
  },
  {
    title: "Phenotype checks",
    meta: "14 logic assertions",
    state: "Passing",
  },
  {
    title: "Methods draft",
    meta: "Assumptions linked",
    state: "Traceable",
  },
];

const principles = [
  "Every cohort rule is versioned before analysis.",
  "Every query, statistic, and agent step remains inspectable.",
  "Every research artifact can be reviewed by humans before it moves forward.",
];

const cards = [
  {
    title: "Instruct agents like research collaborators",
    body: "Start with a study question, protocol constraints, available datasets, and review expectations. Lincei turns that intent into visible work units instead of a hidden chat transcript.",
  },
  {
    title: "Keep clinical definitions reusable",
    body: "Phenotypes, inclusion criteria, exclusions, covariates, and endpoints become durable research assets that future studies can cite, compare, and improve.",
  },
  {
    title: "Review the path, not just the answer",
    body: "Researchers stay close to assumptions, SQL, statistics, figures, and drafts while agents do the mechanical work around them.",
  },
];
---

<Layout>
  <section class="hero">
    <div class="hero-grid" aria-hidden="true"></div>

    <div class="hero-float" aria-hidden="true">
      <span class="hero-float-mark hf-claude" title="Claude">
        <img src="/model-icons/claude.svg" alt="" />
      </span>
      <span class="hero-float-mark hf-codex" title="Codex">
        <img src="/model-icons/openai.svg" alt="" />
      </span>
      <span class="hero-float-mark hf-opencode" title="OpenCode">
        <img src="/model-icons/opencode.svg" alt="" />
      </span>
      <span class="hero-float-mark hf-cursor" title="Cursor">
        <img src="/model-icons/cursor.svg" alt="" />
      </span>
    </div>

    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">Agentic clinical research environment</p>
        <h1 class="hero-title display">Verifiable studies with AI agents in the loop.</h1>
        <p class="hero-sub">
          Lincei helps clinical research teams turn study ideas into reproducible,
          reviewable analyses. Agents define cohorts, write SQL, run statistics,
          and draft methods while every assumption, query, definition, and result
          is recorded for human review.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary btn-lg" href="mailto:hannes@lincei.ai">Request early access</a>
          <a class="btn btn-ghost btn-lg" href="#workflow">Explore workflow</a>
        </div>
      </div>

      <div class="hero-preview">
        <figure class="hero-screenshot-frame">
          <img
            src="/hero-screenshot.webp"
            alt="Temporary Lincei product screenshot placeholder"
            width="2508"
            height="1682"
            loading="eager"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <section id="workflow" class="workflow">
    <div class="container workflow-inner">
      <div class="section-head">
        <p class="eyebrow">Visual research workflow</p>
        <h2>Milestones become cards researchers can inspect.</h2>
        <p>
          Lincei is designed around visible checkpoints: cohorts, phenotypes,
          statistical plans, methodology checks, provenance traces, and draft
          outputs. The workspace makes research progress scannable without
          hiding the evidence.
        </p>
      </div>
      <div class="workflow-board" aria-label="Example Lincei milestone board">
        <article class="milestone is-active">
          <span>01</span>
          <h3>Frame the study</h3>
          <p>Question, data sources, population, endpoints, and review criteria.</p>
        </article>
        <article class="milestone">
          <span>02</span>
          <h3>Build definitions</h3>
          <p>Versioned cohort logic, clinical concepts, covariates, and exclusions.</p>
        </article>
        <article class="milestone">
          <span>03</span>
          <h3>Run analysis</h3>
          <p>SQL, statistics, tables, figures, diagnostics, and sensitivity checks.</p>
        </article>
        <article class="milestone">
          <span>04</span>
          <h3>Review evidence</h3>
          <p>Human approvals, provenance, methods, and exportable study artifacts.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="verification" class="verification">
    <div class="container verification-inner">
      <div class="verification-board" aria-label="Verification checkpoints">
        {
          checkpoints.map((checkpoint) => (
            <article class="checkpoint-card">
              <div class="checkpoint-head">
                <span>{checkpoint.state}</span>
                <span class="status-dot" aria-hidden="true"></span>
              </div>
              <h3>{checkpoint.title}</h3>
              <p>{checkpoint.meta}</p>
            </article>
          ))
        }
      </div>
      <div class="verification-copy">
        <p class="eyebrow">Verification layer</p>
        <h2>AI can make a plausible wrong study very quickly.</h2>
        <p>
          Lincei treats verification as the core product surface. The bottleneck
          is no longer generating an answer; it is proving exactly how the answer
          was produced.
        </p>
        <div class="principle-list">
          {
            principles.map((principle) => (
              <div class="principle">
                <span aria-hidden="true"></span>
                <p>{principle}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="research-system">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Designed for clinical research teams</p>
        <h2>Agentic work without losing scientific control.</h2>
      </div>
      <div class="system-grid">
        {
          cards.map((card) => (
            <article class="system-card">
              <h3>{card.title}</h3>
              <p>{card.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="foundation" class="foundation">
    <div class="container foundation-inner">
      <div class="section-head">
        <p class="eyebrow">Lincei Labs foundation</p>
        <h2>Built from open research infrastructure.</h2>
        <p>
          Lincei grows out of M4 and Vitrine: infrastructure for controlled
          clinical data access, reusable definitions, provenance, and visual
          study workspaces.
        </p>
      </div>
      <div class="foundation-links">
        <a class="foundation-link" href="https://github.com/hannesill/m4" target="_blank" rel="noopener noreferrer">
          <span>M4</span>
          <p>Controlled clinical data access, versioned definitions, provenance, and agent-accessible workflows.</p>
        </a>
        <a class="foundation-link" href="https://github.com/hannesill/vitrine" target="_blank" rel="noopener noreferrer">
          <span>Vitrine</span>
          <p>The visual card system for hosted study workspaces, review checkpoints, and research artifacts.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="container cta-inner">
      <p class="eyebrow">Early development</p>
      <h2>Bring rigorous AI agents into clinical research.</h2>
      <p>
        Lincei is currently for teams who care about reproducibility,
        inspectable automation, and clinical research workflows that survive
        review.
      </p>
      <a class="btn btn-primary btn-lg" href="mailto:hannes@lincei.ai">Start a conversation</a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(82px, 10vw, 138px) 0 0;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image:
      linear-gradient(rgba(17, 24, 39, 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(17, 24, 39, 0.055) 1px, transparent 1px);
    background-size: 74px 74px;
    mask-image: linear-gradient(180deg, black 0%, black 66%, transparent 100%);
  }

  .hero-grid::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 18% 18%, rgba(95, 118, 99, 0.15), transparent 26%),
      radial-gradient(circle at 82% 12%, rgba(109, 35, 50, 0.13), transparent 28%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.38), #ffffff 92%);
  }

  .hero-float {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .hero-float-mark {
    position: absolute;
    display: grid;
    width: clamp(72px, 7vw, 104px);
    height: clamp(72px, 7vw, 104px);
    place-items: center;
    border: 1px solid rgba(17, 24, 39, 0.08);
    border-radius: 24px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.82), rgba(247, 247, 244, 0.7)),
      #fff;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.8) inset,
      0 20px 52px -36px rgba(17, 24, 39, 0.48);
    transform: rotate(var(--rotate));
  }

  .hero-float-mark img {
    width: 46%;
    height: 46%;
    object-fit: contain;
  }

  .hf-claude {
    top: 18%;
    left: max(42px, calc((100vw - 1220px) / 2 - 68px));
    --rotate: -8deg;
  }

  .hf-codex {
    top: 12%;
    right: max(44px, calc((100vw - 1220px) / 2 - 54px));
    --rotate: 7deg;
  }

  .hf-opencode {
    bottom: 28%;
    left: max(30px, calc((100vw - 1220px) / 2 - 96px));
    --rotate: 4deg;
  }

  .hf-cursor {
    right: max(32px, calc((100vw - 1220px) / 2 - 84px));
    bottom: 30%;
    --rotate: -6deg;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .hero-copy {
    display: grid;
    max-width: 900px;
    justify-items: center;
    gap: 22px;
  }

  .hero-title {
    max-width: 920px;
  }

  .hero-sub {
    max-width: 700px;
    color: var(--fg-muted);
    font-size: clamp(1.08rem, 1.5vw, 1.24rem);
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    padding-top: 18px;
  }

  .btn-lg {
    min-height: 48px;
    padding: 13px 18px;
    font-size: 15px;
  }

  .hero-preview {
    width: min(100%, 1040px);
    margin-top: clamp(56px, 8vw, 94px);
  }

  .hero-screenshot-frame {
    overflow: hidden;
    border: 1px solid rgba(17, 24, 39, 0.12);
    border-bottom: 0;
    border-radius: 14px 14px 0 0;
    background: rgba(255, 255, 255, 0.72);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.8) inset,
      0 32px 90px -48px rgba(17, 24, 39, 0.62);
  }

  .hero-screenshot-frame img {
    width: 100%;
    height: auto;
    opacity: 0.96;
  }

  .checkpoint-card,
  .milestone,
  .system-card,
  .foundation-link {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.78);
    box-shadow: var(--shadow-card);
  }

  .checkpoint-card {
    display: grid;
    gap: 10px;
    min-height: 132px;
    padding: 14px;
  }

  .checkpoint-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--sage);
  }

  .checkpoint-card h3 {
    font-size: 15px;
    line-height: 1.2;
  }

  .checkpoint-card p,
  .verification-board p {
    color: var(--fg-muted);
    font-size: 13px;
    line-height: 1.45;
  }

  .workflow,
  .verification,
  .research-system,
  .foundation,
  .cta {
    padding: clamp(72px, 9vw, 128px) 0;
  }

  .workflow-inner {
    display: grid;
    gap: 42px;
  }

  .workflow-board {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  .milestone {
    display: grid;
    min-height: 260px;
    align-content: space-between;
    gap: 28px;
    padding: 18px;
  }

  .milestone span {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
  }

  .milestone h3 {
    max-width: 220px;
    font-family: var(--font-serif);
    font-size: clamp(1.55rem, 2vw, 2.2rem);
    font-weight: 500;
    line-height: 1;
  }

  .milestone p {
    color: var(--fg-muted);
    font-size: 14px;
  }

  .milestone.is-active {
    background:
      linear-gradient(180deg, rgba(109, 35, 50, 0.06), transparent),
      rgba(255, 255, 255, 0.86);
    border-color: color-mix(in srgb, var(--accent) 32%, var(--border));
  }

  .verification {
    background:
      linear-gradient(180deg, rgba(241, 245, 239, 0.66), rgba(255, 255, 255, 0.82)),
      var(--bg-tint);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .verification-inner {
    display: grid;
    grid-template-columns: minmax(320px, 0.8fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(32px, 7vw, 92px);
  }

  .verification-board {
    display: grid;
    gap: 12px;
  }

  .verification-copy {
    display: grid;
    gap: 18px;
    max-width: 680px;
  }

  .verification-copy h2 {
    font-family: var(--font-serif);
    font-size: clamp(2.8rem, 6vw, 6rem);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 0.92;
    text-wrap: balance;
  }

  .verification-copy > p {
    color: var(--fg-muted);
    font-size: clamp(1.08rem, 1.5vw, 1.28rem);
    line-height: 1.65;
  }

  .principle-list {
    display: grid;
    gap: 12px;
    padding-top: 8px;
  }

  .principle {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    color: var(--fg-muted);
  }

  .principle span {
    width: 9px;
    height: 9px;
    margin-top: 8px;
    border-radius: 50%;
    background: var(--accent);
    flex: 0 0 auto;
  }

  .system-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-top: 42px;
  }

  .system-card {
    display: grid;
    gap: 18px;
    min-height: 280px;
    padding: 22px;
  }

  .system-card h3 {
    max-width: 320px;
    font-family: var(--font-serif);
    font-size: clamp(1.65rem, 2.4vw, 2.45rem);
    font-weight: 500;
    line-height: 1;
  }

  .system-card p {
    align-self: end;
    color: var(--fg-muted);
  }

  .foundation {
    background: #fbfbf8;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .foundation-inner {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(340px, 0.85fr);
    gap: clamp(32px, 7vw, 92px);
    align-items: start;
  }

  .foundation-links {
    display: grid;
    gap: 12px;
  }

  .foundation-link {
    display: grid;
    gap: 10px;
    padding: 18px;
    transition: border-color 0.18s ease, transform 0.18s ease;
  }

  .foundation-link:hover {
    border-color: var(--border-strong);
    transform: translateY(-1px);
  }

  .foundation-link span {
    color: var(--accent);
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 600;
    line-height: 1;
  }

  .foundation-link p {
    color: var(--fg-muted);
  }

  .cta {
    text-align: center;
  }

  .cta-inner {
    display: grid;
    justify-items: center;
    gap: 18px;
  }

  .cta h2 {
    max-width: 860px;
    font-family: var(--font-serif);
    font-size: clamp(3rem, 7vw, 7rem);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 0.9;
    text-wrap: balance;
  }

  .cta p:not(.eyebrow) {
    max-width: 680px;
    color: var(--fg-muted);
    font-size: 1.16rem;
    line-height: 1.65;
  }

  @media (max-width: 980px) {
    .verification-inner,
    .foundation-inner {
      grid-template-columns: 1fr;
    }

    .workflow-board,
    .system-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .hero {
      padding-top: 52px;
    }

    .hero-float-mark {
      opacity: 0.42;
      transform: scale(0.76) rotate(var(--rotate));
    }

    .workflow-board,
    .system-grid {
      grid-template-columns: 1fr;
    }

    .milestone,
    .system-card {
      min-height: 220px;
    }
  }
</style>
